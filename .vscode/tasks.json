{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Java with Input/Output",
            "type": "shell",
            "command": "javac -d \"${workspaceFolder}/bin\" \"${file}\" && java -cp \"${workspaceFolder}/bin\" \"${fileBasenameNoExtension}\" < \"${workspaceFolder}/input.txt\" > \"${workspaceFolder}/output.txt\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}